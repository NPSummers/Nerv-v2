fn abi_name(name: string) -> string
    if name == "nerv.arrays.map"
        return "nerv_array_i64_map_closure"
    if name == "nerv.arrays.reduce"
        return "nerv_array_i64_reduce_closure"
    if name == "nerv.net.websocket_run"
        return "nerv_net_websocket_run_closure"
    if name == "nerv.arrays.len"
        return "nerv_array_length"
    if name == "nerv.string.len"
        return "nerv_string_len"
    if name == "nerv.string.concat"
        return "nerv_string_concat"
    if name == "nerv.math.sqrt"
        return "nerv_sqrt"
    if name == "nerv.math.pow"
        return "nerv_pow"
    if name == "nerv.random"
        return "nerv_random_i64"
    if nerv.string.starts_with(name, "nerv.string.") == 1
        return nerv.string.concat("nerv_str_", nerv.string.slice(name, 12, nerv.string.len(name)))
    if nerv.string.starts_with(name, "nerv.arrays.") == 1
        return nerv.string.concat("nerv_array_i64_", nerv.string.slice(name, 12, nerv.string.len(name)))
    if nerv.string.starts_with(name, "nerv.collections.") == 1
        return nerv.string.concat("nerv_", nerv.string.slice(name, 17, nerv.string.len(name)))
    nerv.string.replace(name, ".", "_")
