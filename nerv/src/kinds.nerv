fn keyword(text: string) -> string
    if text == "let"
        return "Let"
    if text == "mut"
        return "Mut"
    if text == "fn"
        return "Fn"
    if text == "struct"
        return "Struct"
    if text == "enum"
        return "Enum"
    if text == "trait"
        return "Trait"
    if text == "impl"
        return "Impl"
    if text == "import"
        return "Import"
    if text == "export"
        return "Export"
    if text == "module"
        return "Module"
    if text == "use"
        return "Use"
    if text == "if"
        return "If"
    if text == "else"
        return "Else"
    if text == "for"
        return "For"
    if text == "in"
        return "In"
    if text == "while"
        return "While"
    if text == "match"
        return "Match"
    if text == "test"
        return "Test"
    if text == "bench"
        return "Bench"
    if text == "unsafe"
        return "Unsafe"
    if text == "return"
        return "Return"
    if text == "break"
        return "Break"
    if text == "continue"
        return "Continue"
    if text == "and"
        return "And"
    if text == "or"
        return "Or"
    if text == "not"
        return "Not"
    if text == "true"
        return "True"
    if text == "false"
        return "False"
    if text == "Some"
        return "Some"
    if text == "None"
        return "None"
    if text == "implements"
        return "Implements"
    "Ident"

fn operator(text: string) -> string
    if text == "..="
        return "RangeInclusive"
    if text == "=>"
        return "FatArrow"
    if text == "->"
        return "ThinArrow"
    if text == "|>"
        return "PipeArrow"
    if text == "=="
        return "EqEq"
    if text == "!="
        return "NotEq"
    if text == "<="
        return "LtEq"
    if text == ">="
        return "GtEq"
    if text == "::"
        return "ColonColon"
    if text == ".."
        return "Range"
    if text == "+"
        return "Plus"
    if text == "-"
        return "Minus"
    if text == "*"
        return "Star"
    if text == "/"
        return "Slash"
    if text == "%"
        return "Percent"
    if text == "<"
        return "Lt"
    if text == ">"
        return "Gt"
    if text == "="
        return "Eq"
    if text == "("
        return "LParen"
    if text == ")"
        return "RParen"
    if text == "["
        return "LBracket"
    if text == "]"
        return "RBracket"
    if text == "{"
        return "LBrace"
    if text == "}"
        return "RBrace"
    if text == ","
        return "Comma"
    if text == "."
        return "Dot"
    if text == ":"
        return "Colon"
    if text == ";"
        return "Semicolon"
    if text == "&"
        return "Ampersand"
    if text == "|"
        return "Pipe"
    if text == "?"
        return "Question"
    ""
