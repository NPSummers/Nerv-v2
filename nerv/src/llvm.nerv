        functions [95] = nerv.ffi.symbol(library, "LLVMDisposeTargetMachine")
        functions [96] = nerv.ffi.symbol(library, "LLVMCreateTargetDataLayout")
        functions [97] = nerv.ffi.symbol(library, "LLVMCopyStringRepOfTargetData")
        functions [98] = nerv.ffi.symbol(library, "LLVMSetDataLayout")
        functions [99] = nerv.ffi.symbol(library, "LLVMDisposeTargetData")
        functions [100] = nerv.ffi.symbol(library, "LLVMTargetMachineEmitToFile")
        functions [101] = nerv.ffi.symbol(library, "LLVMCreatePassBuilderOptions")
        functions [102] = nerv.ffi.symbol(library, "LLVMDisposePassBuilderOptions")
        functions [103] = nerv.ffi.symbol(library, "LLVMRunPasses")
        functions [104] = nerv.ffi.symbol(library, "LLVMGetErrorMessage")
        functions [105] = nerv.ffi.symbol(library, "LLVMDisposeErrorMessage")
    LLVM { library: library, functions: functions }

fn ContextCreate(api: LLVM) -> i64
    assert(api.functions [0] != 0)
    let result = nerv.ffi.call_i64(api.functions [0])
    result

fn ContextDispose(api: LLVM, a0: i64) -> void
    assert(api.functions [1] != 0)
    nerv.ffi.call_void(api.functions [1], a0)

fn ModuleCreateWithNameInContext(api: LLVM, a0: string, a1: i64) -> i64
    let s0 = nerv.ffi.cstring(a0)
    assert(api.functions [2] != 0)
    let result = nerv.ffi.call_i64(api.functions [2], s0, a1)
    nerv.ffi.free(s0)
    result

fn DisposeModule(api: LLVM, a0: i64) -> void
    assert(api.functions [3] != 0)
    nerv.ffi.call_void(api.functions [3], a0)

