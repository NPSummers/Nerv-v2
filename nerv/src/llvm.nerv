import nerv.std

struct LLVM
    library: i64
    functions: []i64

fn open_library(file: string) -> LLVM
    let library = nerv.ffi.open(file)
    let mut functions = [0] * 106
    if library != 0
        functions [0] = nerv.ffi.symbol(library, "LLVMContextCreate")
        functions [1] = nerv.ffi.symbol(library, "LLVMContextDispose")
        functions [2] = nerv.ffi.symbol(library, "LLVMModuleCreateWithNameInContext")
        functions [3] = nerv.ffi.symbol(library, "LLVMDisposeModule")
        functions [4] = nerv.ffi.symbol(library, "LLVMCreateBuilderInContext")
        functions [5] = nerv.ffi.symbol(library, "LLVMDisposeBuilder")
        functions [6] = nerv.ffi.symbol(library, "LLVMVoidTypeInContext")
        functions [7] = nerv.ffi.symbol(library, "LLVMIntTypeInContext")
        functions [8] = nerv.ffi.symbol(library, "LLVMFloatTypeInContext")
        functions [9] = nerv.ffi.symbol(library, "LLVMDoubleTypeInContext")
        functions [10] = nerv.ffi.symbol(library, "LLVMPointerTypeInContext")
        functions [11] = nerv.ffi.symbol(library, "LLVMStructCreateNamed")
        functions [12] = nerv.ffi.symbol(library, "LLVMStructSetBody")
        functions [13] = nerv.ffi.symbol(library, "LLVMStructTypeInContext")
        functions [14] = nerv.ffi.symbol(library, "LLVMFunctionType")
        functions [15] = nerv.ffi.symbol(library, "LLVMAddFunction")
        functions [16] = nerv.ffi.symbol(library, "LLVMGetParam")
        functions [17] = nerv.ffi.symbol(library, "LLVMGetIntTypeWidth")
        functions [18] = nerv.ffi.symbol(library, "LLVMGetEntryBasicBlock")
        functions [19] = nerv.ffi.symbol(library, "LLVMGetFirstInstruction")
        functions [20] = nerv.ffi.symbol(library, "LLVMPositionBuilderBefore")
        functions [21] = nerv.ffi.symbol(library, "LLVMAppendBasicBlockInContext")
        functions [22] = nerv.ffi.symbol(library, "LLVMPositionBuilderAtEnd")
        functions [23] = nerv.ffi.symbol(library, "LLVMGetInsertBlock")
        functions [24] = nerv.ffi.symbol(library, "LLVMGetBasicBlockParent")
        functions [25] = nerv.ffi.symbol(library, "LLVMGetBasicBlockTerminator")
        functions [26] = nerv.ffi.symbol(library, "LLVMBuildAlloca")
        functions [27] = nerv.ffi.symbol(library, "LLVMBuildStore")
        functions [28] = nerv.ffi.symbol(library, "LLVMBuildLoad2")
        functions [29] = nerv.ffi.symbol(library, "LLVMBuildRet")
        functions [30] = nerv.ffi.symbol(library, "LLVMBuildRetVoid")
        functions [31] = nerv.ffi.symbol(library, "LLVMBuildBr")
        functions [32] = nerv.ffi.symbol(library, "LLVMBuildCondBr")
        functions [33] = nerv.ffi.symbol(library, "LLVMBuildUnreachable")
        functions [34] = nerv.ffi.symbol(library, "LLVMBuildAdd")
        functions [35] = nerv.ffi.symbol(library, "LLVMBuildSub")
        functions [36] = nerv.ffi.symbol(library, "LLVMBuildMul")
        functions [37] = nerv.ffi.symbol(library, "LLVMBuildSDiv")
        functions [38] = nerv.ffi.symbol(library, "LLVMBuildUDiv")
        functions [39] = nerv.ffi.symbol(library, "LLVMBuildSRem")
        functions [40] = nerv.ffi.symbol(library, "LLVMBuildURem")
        functions [41] = nerv.ffi.symbol(library, "LLVMBuildFAdd")
        functions [42] = nerv.ffi.symbol(library, "LLVMBuildFSub")
        functions [43] = nerv.ffi.symbol(library, "LLVMBuildFMul")
        functions [44] = nerv.ffi.symbol(library, "LLVMBuildFDiv")
        functions [45] = nerv.ffi.symbol(library, "LLVMBuildFRem")
