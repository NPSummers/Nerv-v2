        functions [79] = nerv.ffi.symbol(library, "LLVMTypeOf")
        functions [80] = nerv.ffi.symbol(library, "LLVMVerifyModule")
        functions [81] = nerv.ffi.symbol(library, "LLVMPrintModuleToString")
        functions [82] = nerv.ffi.symbol(library, "LLVMDisposeMessage")
        functions [83] = nerv.ffi.symbol(library, "LLVMGetDefaultTargetTriple")
        functions [84] = nerv.ffi.symbol(library, "LLVMSetTarget")
        functions [85] = nerv.ffi.symbol(library, "LLVMInitializeX86TargetInfo")
        functions [86] = nerv.ffi.symbol(library, "LLVMInitializeX86Target")
        functions [87] = nerv.ffi.symbol(library, "LLVMInitializeX86TargetMC")
        functions [88] = nerv.ffi.symbol(library, "LLVMInitializeX86AsmPrinter")
        functions [89] = nerv.ffi.symbol(library, "LLVMInitializeAArch64TargetInfo")
